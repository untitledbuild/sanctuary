---
/**
 * v2 landing page.
 *
 * AppDock, Whiteboard, TechLogos, Work, CallToAction and ContactForm are
 * intentionally not composed here — they are kept in the repo (and still
 * type-check) so the Supabase-wired form and the dock/whiteboard motion can be
 * reinstated without rebuilding them.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/sections/Header.astro';
import Hero from '@components/sections/Hero.astro';
import Testimonial from '@components/sections/Testimonial.astro';
import Showcase from '@components/sections/Showcase.astro';
import Manifesto from '@components/sections/Manifesto.astro';
import WhatWeBuild from '@components/sections/WhatWeBuild.astro';
import People from '@components/sections/People.astro';
import Story from '@components/sections/Story.astro';
import Footer from '@components/sections/Footer.astro';
import HatchBand from '@components/primitives/HatchBand.astro';
---

<BaseLayout>
  <Header />
  <main>
    <Hero />
    <Testimonial />
    <Showcase />
    <Manifesto />
    <HatchBand />
    <WhatWeBuild />
    <HatchBand />
    <People />
    <HatchBand />
    <Story />
  </main>
  <Footer />
</BaseLayout>
