---
/**
 * v2 landing page.
 *
 * AppDock, Whiteboard, TechLogos and Work are intentionally not composed here
 * — they are kept in the repo (and still type-check) so the dock/whiteboard
 * motion can be reinstated without rebuilding it. CallToAction and
 * ContactForm ARE composed (below Story): every "Collaborate" / "SEND
 * MESSAGE" CTA site-wide scrolls to the form's `id="start"`.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/sections/Header.astro';
import Hero from '@components/sections/Hero.astro';
import Testimonial from '@components/sections/Testimonial.astro';
import Showcase from '@components/sections/Showcase.astro';
import Manifesto from '@components/sections/Manifesto.astro';
import WhatWeBuild from '@components/sections/WhatWeBuild.astro';
import People from '@components/sections/People.astro';
import Story from '@components/sections/Story.astro';
import CallToAction from '@components/sections/CallToAction.astro';
import ContactForm from '@components/sections/ContactForm.astro';
import Footer from '@components/sections/Footer.astro';
import HatchBand from '@components/primitives/HatchBand.astro';
import Container from '@components/primitives/Container.astro';
---

<BaseLayout>
  <Header />
  <main>
    <Hero />
    <Testimonial />
    <Showcase />
    <Manifesto />
    <HatchBand />
    <WhatWeBuild />
    <HatchBand />
    <People />
    <HatchBand />
    <Story />
    <CallToAction />
    <section class="relative pb-[var(--section-y)]">
      <Container width="container">
        <div class="mx-auto max-w-[54.8125rem]">
          <ContactForm />
        </div>
      </Container>
    </section>
  </main>
  <Footer />
</BaseLayout>
