---
/**
 * Careers page — hero, the open-roles list, and the apply dialog.
 *
 * The hero CTA is a plain mailto:, so there is always a working way to reach us
 * even though the dialog itself needs JS.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/sections/Header.astro';
import Hero from '@components/sections/Hero.astro';
import Openings from '@components/sections/Openings.astro';
import ApplyDialog from '@components/sections/ApplyDialog.astro';
import Footer from '@components/sections/Footer.astro';
import HatchBand from '@components/primitives/HatchBand.astro';
import { site, type HeroContent } from '@data/site';

const hero = site.careers.hero as unknown as HeroContent;
---

<BaseLayout
  title={`Careers — ${site.name}`}
  description="We're hiring mid-to-senior engineers and designers — 3+ years, remote, across iOS, AI, React, Node.js, AWS and design."
>
  <Header />
  <main>
    <Hero content={hero} />
    <HatchBand />
    <Openings />
  </main>
  <Footer />
  <ApplyDialog />
  <script>
    import '../scripts/apply.ts';
  </script>
</BaseLayout>
