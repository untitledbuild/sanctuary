---
/**
 * About page — reuses the shared Hero (with the about copy), the Our Story
 * document card and the leadership grid from the home page, plus the two
 * about-only bands: the "_how we work" principles and the founder's note.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/sections/Header.astro';
import Hero from '@components/sections/Hero.astro';
import Story from '@components/sections/Story.astro';
import HowWeWork from '@components/sections/HowWeWork.astro';
import People from '@components/sections/People.astro';
import FoundersNote from '@components/sections/FoundersNote.astro';
import Footer from '@components/sections/Footer.astro';
import HatchBand from '@components/primitives/HatchBand.astro';
import { site, type HeroContent } from '@data/site';

const hero = site.about.hero as unknown as HeroContent;
---

<BaseLayout
  title={`About — ${site.name}`}
  description="A small studio that builds products, AI systems, and the occasional weird side project. Here's the short version of how we got here."
>
  <Header />
  <main>
    <Hero content={hero} />
    <Story />
    <HowWeWork />
    <HatchBand />
    <People />
    <HatchBand />
    <FoundersNote />
  </main>
  <Footer />
</BaseLayout>
