---
/**
 * Experience levels + the speculative-application card. The levels are a plain
 * list of what we hire into; the card beside them is the path for people who
 * don't match any posted role, which is the whole point of the section.
 */
import SectionHead from '@components/primitives/SectionHead.astro';
import Icon from '@components/primitives/Icon.astro';
import { site } from '@data/site';

const { label, title, body, items, exceptional } = site.careers.levels;
---

<section id="levels" class="relative scroll-mt-[5rem] py-[clamp(2.5rem,5vw,4rem)]">
  <div class="mx-auto w-full max-w-[43.125rem] px-5 md:px-0">
    <SectionHead label={label} title={title} body={body} />

    <div class="mt-[1.5rem] grid grid-cols-1 gap-[1.25rem] lg:grid-cols-[1.15fr_1fr]">
      <ul class="flex flex-wrap gap-[0.4rem] self-start" data-reveal>
        {
          items.map((l) => (
            <li class="rounded-[4px] border border-hairline-soft bg-card px-[0.65rem] py-[0.35rem] font-geist-mono text-[0.78rem] tracking-tighter text-faint">
              {l}
            </li>
          ))
        }
      </ul>

      <div id="introduce" class="scroll-mt-[5rem]" data-reveal data-reveal-delay="0.08">
        <article
          class="flex h-full flex-col rounded-[var(--radius-card)] border border-hairline bg-card p-[1.2rem]"
          data-tilt="5"
        >
          <h3 class="font-serif text-[1.2rem] leading-[1.25] tracking-serif text-heading">
            {exceptional.title}
          </h3>
          <p class="mt-[0.45rem] font-geist text-[0.85rem] leading-snug tracking-tight text-body">
            {exceptional.body}
          </p>
          <button
            type="button"
            class="mt-[1rem] inline-flex cursor-pointer items-center justify-center gap-[0.5rem] self-start rounded-[var(--radius-control)] bg-ink px-[0.9rem] py-[0.5rem] font-geist text-[0.85rem] font-medium tracking-tight text-white transition-colors duration-200 hover:bg-heading"
            data-apply-open
          >
            {exceptional.cta}
            <Icon name="chevron-down" size={13} class="-rotate-90" stroke={2.2} />
          </button>
        </article>
      </div>
    </div>
  </div>
</section>
