---
/**
 * "We Look for Builders" — the seven traits, as tilting cards on the same
 * blueprint grid the rest of the site uses.
 */
import SectionHead from '@components/primitives/SectionHead.astro';
import { site, type Trait } from '@data/site';

const { label, title, body, traits } = site.careers.lookFor;
const items = traits as unknown as Trait[];
---

<section id="builders" class="relative py-[clamp(2.5rem,5vw,4rem)]">
  <div class="mx-auto w-full max-w-[43.125rem] px-5 md:px-0">
    <SectionHead label={label} title={title} body={body} />

    <div class="dashed-h -mx-[33px] mt-[1.5rem] hidden sm:block" aria-hidden="true"></div>

    <ul class="mt-[1.5rem] grid grid-cols-1 gap-[1rem] sm:grid-cols-2">
      {
        items.map((t, i) => (
          <li data-reveal data-reveal-delay={(i % 2) * 0.06}>
            <article
              class="flex h-full flex-col rounded-[var(--radius-card)] border border-hairline-soft bg-card p-[1.1rem]"
              data-tilt="6"
            >
              <h3 class="font-serif text-[1.1rem] leading-[1.25] tracking-serif text-heading">
                {t.title}
              </h3>
              <p class="mt-[0.4rem] font-geist text-[0.85rem] leading-snug tracking-tight text-body">
                {t.body}
              </p>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>
