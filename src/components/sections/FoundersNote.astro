---
/**
 * Founder's note — the closing message shown as a handwritten page inside an
 * app window: chrome on top, dotted "paper" holding Caveat text, and a zoom
 * bar along the bottom. All the chrome is decorative; only the note itself is
 * exposed to assistive tech.
 */
import Icon from '@components/primitives/Icon.astro';
import { site } from '@data/site';

const { docTitle, body, signature, zoom } = site.about.foundersNote;

/* Faint dot grid, the same motif the hero frame uses. */
const paper =
  'background-image:radial-gradient(rgba(0,0,0,0.10) 0.055rem, transparent 0.055rem);' +
  'background-size:1.15rem 1.15rem';
---

<section aria-label="A note from the team" class="relative py-[clamp(2.5rem,5vw,4rem)]">
  <div class="mx-auto w-full max-w-[38rem] px-[var(--container-pad)]">
    {/* data-reveal sits on the wrapper, not the card: the reveal tween writes an
        inline transform, which would override the tilt's transform below. */}
    <div data-reveal>
    <article
      class="overflow-hidden rounded-[0.9rem] bg-card shadow-[var(--shadow-tile-hero)]"
      data-tilt="5"
    >
      {/* window chrome */}
      <div class="flex items-center gap-[0.55rem] px-[0.9rem] py-[0.65rem]" aria-hidden="true">
        <span class="flex shrink-0 gap-[0.28rem]">
          {Array.from({ length: 3 }).map(() => (
            <span class="h-[0.42rem] w-[0.42rem] rounded-full bg-gray-300"></span>
          ))}
        </span>
        <Icon name="perspective" size={13} class="ml-[0.2rem] text-gray-500" stroke={1.7} />
        <Icon name="chevron-down" size={12} class="ml-[0.35rem] rotate-90 text-gray-500" stroke={2} />
        <span class="font-geist text-[0.78rem] tracking-tight text-name">{docTitle}</span>
        <span class="ml-auto flex items-center gap-[0.7rem] text-gray-500">
          <Icon name="cube" size={13} stroke={1.7} />
          <Icon name="grid" size={13} stroke={1.7} />
          <Icon name="info-square" size={13} stroke={1.7} />
          <Icon name="share" size={13} stroke={1.7} />
          <span class="ml-[0.5rem] flex items-center gap-[0.7rem] border-l border-hairline-soft pl-[0.7rem]">
            <Icon name="share" size={13} stroke={1.7} />
            <Icon name="edit" size={13} stroke={1.7} />
          </span>
        </span>
      </div>

      {/* handwritten page */}
      <div class="border-y border-hairline-soft px-[clamp(1.25rem,4vw,2.4rem)] py-[clamp(1.75rem,4vw,2.6rem)]" style={paper}>
        <p class="font-hand text-[clamp(1.05rem,2.4vw,1.3rem)] leading-[1.85] tracking-tight text-navy">
          {body}
        </p>
        <p class="mt-[1.4rem] font-hand text-[clamp(1.05rem,2.4vw,1.3rem)] leading-[1.85] tracking-tight text-navy">
          {signature}
        </p>
      </div>

      {/* zoom bar */}
      <div class="flex items-center gap-[0.6rem] px-[0.9rem] py-[0.6rem] text-gray-500" aria-hidden="true">
        <span class="flex items-center gap-[0.5rem] rounded-full border border-hairline-soft px-[0.6rem] py-[0.25rem]">
          <Icon name="plus" size={11} class="rotate-45" stroke={2} />
          <span class="font-geist text-[0.72rem] tracking-tight text-faint">{zoom}</span>
          <Icon name="plus" size={11} stroke={2} />
          <span class="ml-[0.3rem] flex items-center gap-[0.45rem] border-l border-hairline-soft pl-[0.55rem]">
            <Icon name="chevron-down" size={11} class="rotate-90" stroke={2} />
            <Icon name="grid" size={11} stroke={1.8} />
            <Icon name="chevron-down" size={11} class="-rotate-90" stroke={2} />
          </span>
          <Icon name="settings" size={11} class="ml-[0.2rem]" stroke={1.8} />
        </span>
        <span class="ml-auto flex items-center gap-[0.6rem]">
          <Icon name="perspective" size={12} stroke={1.7} />
          <Icon name="grid" size={12} stroke={1.7} />
        </span>
      </div>
    </article>
    </div>
  </div>
</section>
