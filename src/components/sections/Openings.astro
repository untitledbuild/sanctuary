---
/**
 * Open roles — one row per practice area inside the dashed blueprint frame.
 *
 * Each row is a real <button> that opens the apply dialog with that area
 * preselected, so the whole row is keyboard-reachable and announces itself
 * rather than being a click handler on a div.
 *
 * The tile carries the area's index rather than a brand logo: these areas each
 * span six-to-eight technologies, so no single mark represents one honestly —
 * the stack tags do that job. With JS off the dialog can't open, so the hero's
 * mailto: CTA stays the reachable path (see careers.astro).
 */
import Icon from '@components/primitives/Icon.astro';
import { site, type Opening } from '@data/site';

const openings = site.careers.openings as unknown as Opening[];

/* Keep the tag row to one or two lines; the rest are summarised. */
const TAGS_SHOWN = 6;
---

<section id="openings" class="relative py-[clamp(1.5rem,3vw,2.5rem)]">
  <div class="relative mx-auto w-full max-w-[43.125rem] px-5 md:px-0">
    {/* frame verticals */}
    <div
      class="pointer-events-none absolute inset-y-[-0.75rem] left-[-21px] right-[-21px] hidden sm:block"
      aria-hidden="true"
    >
      <span class="dashed-v absolute inset-y-0 left-0"></span>
      <span class="dashed-v absolute inset-y-0 right-0"></span>
    </div>

    <h2 class="sr-only">Open roles</h2>

    <ul class="flex flex-col gap-[0.75rem]">
      {
        openings.map((job, i) => {
          const shown = job.stack.slice(0, TAGS_SHOWN);
          const rest = job.stack.length - shown.length;
          return (
            <li data-reveal data-reveal-delay={Math.min(i, 5) * 0.05}>
              <button
                type="button"
                class="group dashed-box flex w-full cursor-pointer items-start gap-[1rem] rounded-[var(--radius-card)] bg-card/70 px-[1rem] py-[0.9rem] text-left transition-colors duration-200 hover:bg-card"
                data-apply-open
                data-position={job.title}
              >
                <span
                  class="mt-[0.15rem] grid h-[2.5rem] w-[2.5rem] shrink-0 place-items-center rounded-[var(--radius-control)] border border-hairline-soft bg-card font-geist-mono text-[0.9rem] tracking-tighter text-label transition-colors duration-200 group-hover:text-heading"
                  aria-hidden="true"
                >
                  {job.index}
                </span>

                <span class="min-w-0 flex-1">
                  <span class="block font-serif text-[1.15rem] leading-[1.3] tracking-serif text-heading">
                    {job.title}
                  </span>
                  <span class="mt-[0.2rem] block font-geist text-[0.85rem] leading-snug tracking-tight text-body">
                    {job.summary}
                  </span>
                  <span class="mt-[0.3rem] block font-geist text-[0.8rem] tracking-tight text-label">
                    {job.type} · {job.experience} · {job.location}
                  </span>
                  <span class="mt-[0.4rem] flex flex-wrap gap-[0.3rem]">
                    {shown.map((s) => (
                      <span class="rounded-[3px] bg-plate px-[0.4rem] py-[0.1rem] font-geist-mono text-[0.65rem] tracking-tighter text-faint">
                        {s}
                      </span>
                    ))}
                    {rest > 0 && (
                      <span class="px-[0.15rem] py-[0.1rem] font-geist-mono text-[0.65rem] tracking-tighter text-muted">
                        +{rest} more
                      </span>
                    )}
                  </span>
                </span>

                <span
                  class="mt-[0.5rem] shrink-0 text-gray-400 transition-transform duration-200 group-hover:translate-x-[3px]"
                  aria-hidden="true"
                >
                  <Icon name="chevron-down" size={18} class="-rotate-90" stroke={2} />
                </span>
                <span class="sr-only">— apply for {job.title}</span>
              </button>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
