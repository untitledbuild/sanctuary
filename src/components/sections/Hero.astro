---
/**
 * Hero — a centred serif headline treated like a selected layer on a Figma
 * canvas: dashed "selection" boxes bracket individual runs of the line, one
 * carrying a layer-name chip, another a small tag. Lead copy and the black
 * Collaborate button sit underneath.
 *
 * Shared by the home and about pages: pass `content` to override the default
 * (home) copy. The boxes are decoration only — the heading reads as one
 * continuous sentence to assistive tech, and the chips are aria-hidden.
 */
import Icon from '@components/primitives/Icon.astro';
import { site, type HeroContent, type HeadlineRun } from '@data/site';

interface Props {
  content?: HeroContent;
}
/* `site` is `as const`, so widen back to the declared shape. */
const { content = site.hero as unknown as HeroContent } = Astro.props;
const { headline, subtitle, layerLabel, techTag, cta, secondaryCta, width = '38rem' } = content;
const runs = headline as HeadlineRun[];

const chip =
  'rounded-[3px] bg-ink px-[0.4rem] py-[0.16rem] font-geist-mono ' +
  'text-[0.6rem] font-medium leading-[1.35] tracking-tighter text-white';
---

<section id="top" class="relative pt-[clamp(2rem,5vw,4rem)] pb-[clamp(1.5rem,3vw,2.5rem)]">
  <div class="mx-auto w-full px-[var(--container-pad)] text-center" style={`max-width:${width}`}>
    <h1
      class="font-serif text-[clamp(2rem,5.2vw,3rem)] leading-[1.16] tracking-serif text-heading"
      data-reveal
    >
      {
        runs.map((run, i) => (
          <>
            {i > 0 && ' '}
            {run.break && <br class="hidden sm:inline" />}
            {run.box ? (
              <span class="relative inline-block">
                <span class="dashed-box relative inline-block px-[0.28em] py-[0.02em]">{run.text}</span>
                {run.chip === 'label' && (
                  <span class:list={['absolute -top-[1.15em] left-0 whitespace-nowrap', chip]} aria-hidden="true">
                    {layerLabel}
                  </span>
                )}
                {run.chip === 'tag' && (
                  <span
                    class:list={[
                      'absolute -bottom-[1.1em] right-0 inline-flex items-center gap-[0.3em] whitespace-nowrap',
                      chip,
                    ]}
                    aria-hidden="true"
                  >
                    <Icon name="cursor" size={8} class="shrink-0" />
                    {techTag}
                  </span>
                )}
              </span>
            ) : (
              <span>{run.text}</span>
            )}
          </>
        ))
      }
    </h1>

    {
      subtitle && (
        <p
          class="mx-auto mt-[clamp(1.75rem,3.5vw,2.5rem)] max-w-[26rem] font-sans text-[1rem] font-medium leading-[1.5] tracking-tight text-body"
          data-reveal
          data-reveal-delay="0.08"
        >
          {subtitle}
        </p>
      )
    }

    <div
      class:list={[
        'flex flex-wrap items-center justify-center gap-[0.75rem]',
        subtitle ? 'mt-[clamp(1.25rem,2.5vw,1.75rem)]' : 'mt-[clamp(1.75rem,3.5vw,2.5rem)]',
      ]}
      data-reveal
      data-reveal-delay="0.16"
    >
      <a
        href={cta.href}
        class="group inline-flex items-center gap-[0.7rem] rounded-[var(--radius-field)] bg-ink py-[0.55rem] pl-[0.95rem] pr-[0.5rem] font-geist-mono text-[0.95rem] font-medium tracking-tighter text-white transition-colors duration-200 hover:bg-heading"
      >
        {cta.label}
        <span
          class="grid h-[1.35rem] w-[1.35rem] place-items-center rounded-[3px] border border-white/25 transition-transform duration-200 group-hover:translate-x-[2px]"
          aria-hidden="true"
        >
          <Icon name="chevron-down" size={13} class="-rotate-90" stroke={2.4} />
        </span>
      </a>

      {
        secondaryCta && (
          <a
            href={secondaryCta.href}
            class="inline-flex items-center rounded-[var(--radius-field)] border border-hairline px-[0.95rem] py-[0.55rem] font-geist-mono text-[0.95rem] font-medium tracking-tighter text-heading transition-colors duration-200 hover:border-heading hover:bg-card"
          >
            {secondaryCta.label}
          </a>
        )
      }
    </div>
  </div>
</section>
