---
/**
 * "Our Story" — the copy presented as a Notion-style document: window chrome
 * (traffic lights, doc title, editor toolbar) over a white page with a
 * timestamp, heading and body. The chrome is decorative; only the prose is
 * exposed to assistive tech.
 */
import Icon from '@components/primitives/Icon.astro';
import { site } from '@data/site';

const { docTitle, date, title, paragraphs } = site.story;
---

<section id="about" class="relative py-[clamp(3rem,6vw,5rem)]">
  <div class="mx-auto w-full max-w-[38rem] px-[var(--container-pad)]">
    {/* data-reveal sits on the wrapper, not the card: the reveal tween writes an
        inline transform, which would override the tilt's transform below. */}
    <div data-reveal>
    <article
      class="overflow-hidden rounded-[0.9rem] bg-card shadow-[var(--shadow-tile-hero)]"
      data-tilt="5"
    >
      {/* window chrome */}
      <div class="flex items-center gap-[0.6rem] px-[1rem] py-[0.7rem]" aria-hidden="true">
        <span class="flex shrink-0 gap-[0.28rem]">
          {Array.from({ length: 3 }).map(() => (
            <span class="h-[0.42rem] w-[0.42rem] rounded-full bg-gray-300"></span>
          ))}
        </span>
        <span class="font-serif text-[0.8rem] tracking-serif text-name">{docTitle}</span>
        <span class="ml-auto flex items-center gap-[0.55rem] text-gray-500">
          <span class="font-geist text-[0.72rem] font-medium">Aa</span>
          <Icon name="grid" size={12} stroke={1.8} />
          <Icon name="perspective" size={12} stroke={1.8} />
          <Icon name="share" size={12} stroke={1.8} />
          <span class="grid h-[1.15rem] w-[1.15rem] place-items-center rounded-[5px] border border-hairline-soft">
            <Icon name="chevron-down" size={10} class="-rotate-90" stroke={2} />
          </span>
        </span>
      </div>

      {/* document body */}
      <div class="px-[clamp(1.25rem,4vw,2.4rem)] pb-[clamp(1.75rem,4vw,2.6rem)]">
        <p class="text-center font-geist text-[0.72rem] tracking-tight text-muted">{date}</p>
        <h2 class="mt-[1.1rem] font-serif text-[1.8rem] leading-[1.2] tracking-serif text-heading">
          {title}
        </h2>
        {
          paragraphs.map((p) => (
            <p class="mt-[0.9rem] font-geist text-[0.9rem] leading-[1.6] tracking-tight text-faint">
              {p}
            </p>
          ))
        }
      </div>
    </article>
    </div>
  </div>
</section>
