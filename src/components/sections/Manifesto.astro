---
/**
 * "we ship things that work" — the line is styled as selected text (grey
 * highlight behind each word) with the little floating selection toolbar
 * underneath, echoing the Figma-canvas motif from the hero.
 *
 * The toolbar is decorative chrome, not a control surface, so it is
 * aria-hidden rather than rendered as buttons a keyboard user could reach.
 */
import Icon from '@components/primitives/Icon.astro';
import { site } from '@data/site';

const { title, actions } = site.manifesto;
---

<section aria-label="How we work" class="relative py-[clamp(3.5rem,8vw,6rem)]">
  <div class="mx-auto w-full max-w-[36rem] px-[var(--container-pad)] text-center">
    <h2
      class="font-serif text-[clamp(2rem,5vw,2.9rem)] leading-[1.24] tracking-serif text-heading"
      data-reveal
    >
      {
        title.split('\n').map((line) => (
          <span class="block">
            <span class="box-decoration-clone bg-plate px-[0.2em] py-[0.04em]">{line}</span>
          </span>
        ))
      }
    </h2>

    {/* floating selection toolbar */}
    <div
      class="mt-[clamp(1.25rem,2.5vw,1.75rem)] inline-flex items-center gap-[0.6rem] rounded-full border border-hairline bg-card px-[0.85rem] py-[0.45rem] shadow-[var(--shadow-control)]"
      aria-hidden="true"
      data-reveal
      data-reveal-delay="0.1"
    >
      <span class="font-geist text-[0.8rem] tracking-tight text-faint">{actions[0]}</span>
      <span class="grid h-[1.1rem] w-[1.1rem] place-items-center rounded-full border border-hairline text-faint">
        <Icon name="plus" size={9} class="rotate-45" stroke={2.2} />
      </span>
      <span class="font-geist text-[0.8rem] tracking-tight text-faint">{actions[1]}</span>
      <span class="grid h-[1.1rem] w-[1.1rem] place-items-center text-faint">
        <Icon name="chevron-down" size={11} class="-rotate-90" stroke={2.2} />
      </span>
    </div>
  </div>
</section>
