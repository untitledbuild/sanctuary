---
/**
 * "People" — leadership grid inside the dashed "blueprint" frame (left/right
 * verticals + horizontals bracketing the grid). Three cards per row on
 * desktop, two on tablet, one on mobile. Each card is static — portrait,
 * name, title and bio all visible at once, no hover-to-reveal — with a
 * gentle lift on hover/focus as the only motion.
 */
import Icon from '@components/primitives/Icon.astro';
import { site, type TeamMember } from '@data/site';

const { title, subtitle, members } = site.people;
const all = members as unknown as TeamMember[];

// Horizontals overshoot the verticals by 12px each side → corners cross (Figma).
const sep = 'dashed-h hidden sm:block -mx-[33px]';
---

<section id="people" class="relative py-[var(--section-y)]">
  {/* spine column, no desktop padding so the frame overshoot lands exactly */}
  <div class="relative mx-auto w-full max-w-[var(--grid)] px-5 md:px-0">
    {/* frame verticals */}
    <div class="pointer-events-none absolute inset-y-[-0.75rem] left-[-21px] right-[-21px] hidden sm:block" aria-hidden="true">
      <span class="dashed-v absolute inset-y-0 left-0"></span>
      <span class="dashed-v absolute inset-y-0 right-0"></span>
    </div>

    <header data-reveal>
      <h2 class="font-serif text-[clamp(1.6rem,3.6vw,2.05rem)] leading-[1.2] tracking-serif text-heading">
        {title}
      </h2>
      <p class="mt-[0.6rem] max-w-[24rem] font-geist text-[0.9rem] leading-[1.5] tracking-tight text-body">
        {subtitle}
      </p>
    </header>

    {/* dashed lines below heading, bracketing the top of the card grid */}
    <div class:list={[sep, 'mt-[1.3rem]']}></div>
    <div class:list={[sep, 'mt-[1.8rem]']}></div>

    <ul class="mt-[1.6rem] grid grid-cols-1 gap-[1.5rem] sm:grid-cols-2 lg:grid-cols-3">
      {all.map((m, i) => (
        <li data-reveal data-reveal-delay={(i % 3) * 0.08}>
          <div class="member dashed-box relative h-full rounded-[var(--radius-card)] p-[1.15rem]">
            <div class="h-[4.5rem] w-[4.5rem] overflow-hidden rounded-full bg-portrait">
              <img
                src={m.image ?? '/team/programmer.png'}
                alt=""
                class="h-full w-full object-cover"
                loading="lazy"
              />
            </div>
            <div class="mt-[0.9rem]">
              <p class="font-serif text-[1.2rem] leading-[1.2] tracking-serif text-heading">{m.name}</p>
              <p class="mt-[0.2rem] font-geist text-[0.9rem] tracking-tight text-label">{m.title}</p>
            </div>
            <p class="mt-[0.9rem] font-geist text-[0.85rem] leading-snug tracking-tight text-body">
              {m.bio}
            </p>

            {m.linkedin && (
              <a
                href={m.linkedin}
                class="absolute right-[0.9rem] top-[0.9rem] z-10 grid h-[1.875rem] w-[1.875rem] place-items-center rounded-[6px] bg-ink text-white transition-colors duration-200 hover:bg-brand"
                aria-label={`${m.name} on LinkedIn`}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon name="linkedin" size={15} />
              </a>
            )}
          </div>
        </li>
      ))}
    </ul>

    {/* closing dashed line */}
    <div class:list={[sep, 'mt-[1.6rem]']}></div>
  </div>
</section>

<style>
  /* Keep the 30px badge but give it a 44px tap target. */
  .member a::after {
    content: '';
    position: absolute;
    inset: -7px;
  }

  @media (hover: hover) and (pointer: fine) {
    .member {
      transition: transform 0.25s ease-out, box-shadow 0.25s ease-out;
    }

    .member:hover,
    .member:focus-within {
      transform: translateY(-3px);
      box-shadow: var(--shadow-control);
    }

    @media (prefers-reduced-motion: reduce) {
      .member,
      .member:hover,
      .member:focus-within {
        transition: none;
        transform: none;
      }
    }
  }
</style>
