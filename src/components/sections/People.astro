---
/**
 * "People" — team grid inside a dashed "blueprint" frame (left/right verticals +
 * horizontals below the heading and bracketing the card grid, per Figma). Each
 * card is a circular portrait (LinkedIn badge on the rim) over a mono name-plate
 * that's nudged right (Figma: image x407, plate x425), title, and a short bio.
 * Members without a photo fall back to the generic programmer illustration.
 * Frame shows on the 3-col desktop layout; mobile drops it.
 *
 * All members share a single CSS grid (2-up mobile, 3-up desktop) so cards
 * always fill left-to-right regardless of where the desktop dashed separators
 * land — a per-row-of-3 separate list would leave the odd member out (2-up
 * wrapping breaks at each group-of-3 boundary), stacking lone cards on mobile.
 */
import Icon from '@components/primitives/Icon.astro';
import { site, type TeamMember } from '@data/site';

const { title, subtitle, members } = site.people;
const all = members as unknown as TeamMember[];

const n = all.length;
const cols = Math.min(n, 3) as 1 | 2 | 3;

// Desktop column count class — literal map so Tailwind emits the class.
const DESKTOP_COLS: Record<1 | 2 | 3, string> = {
  1: 'sm:grid-cols-1',
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-3',
};

// Horizontals overshoot the verticals by 12px each side → corners cross (Figma).
const sep = 'dashed-h hidden sm:block -mx-[33px]';
---

<section id="people" class="relative py-[var(--section-y)]">
  {/* spine column, no desktop padding so the frame overshoot lands exactly */}
  <div class="relative mx-auto w-full max-w-[43.125rem] px-5 md:px-0">
    {/* frame verticals */}
    <div class="pointer-events-none absolute inset-y-[-0.75rem] left-[-21px] right-[-21px] hidden sm:block" aria-hidden="true">
      <span class="dashed-v absolute inset-y-0 left-0"></span>
      <span class="dashed-v absolute inset-y-0 right-0"></span>
    </div>

    <header data-reveal>
      <h2 class="font-sans text-[2.5rem] font-semibold leading-[1.14] tracking-tight text-heading">
        {title}
      </h2>
      <p class="mt-[0.8125rem] max-w-[28.5rem] font-sans text-[1.125rem] font-medium leading-[1.29] tracking-tight text-body">
        {subtitle}
      </p>
    </header>

    {/* dashed lines below heading, bracketing the top of the card grid */}
    <div class:list={[sep, 'mt-[1.3rem]']}></div>
    <div class:list={[sep, 'mt-[1.8rem]']}></div>

    <ul class:list={['mt-[1.6rem] grid grid-cols-2 gap-x-[1.9375rem] gap-y-[1.6rem]', DESKTOP_COLS[cols]]}>
      {all.map((m, i) => (
        <>
          {/* row separator every 3 members — hidden (and so excluded from
              flow) on mobile, so the 2-up grid keeps filling left-to-right */}
          {i > 0 && i % 3 === 0 && (
            <li class:list={[sep, 'col-span-full my-[0.2rem] list-none']} aria-hidden="true"></li>
          )}
          <li class="flex flex-col" data-reveal data-reveal-delay={(i % cols) * 0.06}>
            {/* portrait — circular, inset from the card edge */}
            <div class="relative mx-auto w-[78%]">
              <div class="aspect-square overflow-hidden rounded-full bg-surface">
                <img src={m.image ?? '/team/programmer.png'} alt={m.name} class="h-full w-full object-cover" loading="lazy" />
              </div>
              {m.linkedin && (
                <a
                  href={m.linkedin}
                  class="absolute bottom-[2%] right-[2%] grid h-[1.875rem] w-[1.875rem] place-items-center rounded-full bg-[#0A66C2] text-white ring-2 ring-card transition-colors hover:bg-[#084e94]"
                  aria-label={`${m.name} on LinkedIn`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <Icon name="linkedin" size={15} />
                </a>
              )}
            </div>
            {/* name-plate + title + bio, nudged right of the image (Figma offset) */}
            <div class="ml-[8.78%] mt-[0.75rem] w-[97.07%]">
              <div class="bg-plate px-[0.814rem] py-[0.465rem]">
                <span class="font-geist-mono text-[1.1625rem] font-medium tracking-tighter text-name">{m.name}</span>
              </div>
              <div class="px-[0.814rem] py-[0.465rem]">
                <span class="font-geist text-[1.046rem] tracking-tighter text-label">{m.title}</span>
              </div>
              <p class="px-[0.814rem] pb-[0.465rem] font-geist text-[0.875rem] leading-snug tracking-tight text-body">
                {m.bio}
              </p>
            </div>
          </li>
        </>
      ))}
    </ul>

    {/* closing dashed line */}
    <div class:list={[sep, 'mt-[1.6rem]']}></div>
  </div>
</section>
