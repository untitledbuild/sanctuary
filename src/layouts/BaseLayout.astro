---
import "@/styles/global.css";
import { site } from "@data/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name}: You need software. We build it.`,
  description = site.description,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Usercentrics CMP -->
    <script
      is:inline
      id="usercentrics-cmp"
      src="https://app.usercentrics.eu/browser-ui/latest/loader.js"
      data-version="preview"
      data-settings-id="7ah7-7ZiK04Pax"
      async></script>

    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-F3PMRFPQ0G"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-F3PMRFPQ0G");
    </script>

    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-W6342TDT");
    </script>
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#fffefd" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Supabase config for the contact form (PUBLIC anon key — safe to expose;
         see infra/supabase/schema.sql for the INSERT-only RLS that secures it). -->
    <meta
      name="supabase-url"
      content={import.meta.env.PUBLIC_SUPABASE_URL ?? ""}
    />
    <meta
      name="supabase-anon-key"
      content={import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? ""}
    />

    <!--
      Pre-paint bootstrap: hide reveal elements before first paint to avoid a
      flash, but only when JS is on AND motion is allowed. A failsafe un-hides
      everything if motion.ts never runs, so content can never get stuck.
    -->
    <script is:inline>
      (function () {
        try {
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;
          var root = document.documentElement;
          root.classList.add("js-motion");
          setTimeout(function () {
            if (!window.__motionReady) root.classList.remove("js-motion");
          }, 2500);
        } catch (e) {}
      })();
    </script>

    <!-- Brevo Conversations {literal} -->
    <script is:inline>
      (function (d, w, c) {
        w.BrevoConversationsID = "6a8a370f590231d6e20a6709";
        w[c] = w[c] || function () {
          (w[c].q = w[c].q || []).push(arguments);
        };
        var s = d.createElement("script");
        s.async = true;
        s.src = "https://conversations-widget.brevo.com/brevo-conversations.js";
        if (d.head) d.head.appendChild(s);
      })(document, window, "BrevoConversations");
    </script>
    <!-- /Brevo Conversations {/literal} -->
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-W6342TDT"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <!-- No global backdrop: each section owns its own grid/dot/hatch treatment
         to match the Figma (the engineering motif varies band to band). -->
    <slot />

    <script>
      import "../scripts/motion.ts";
      import "../scripts/form.ts";
    </script>
  </body>
</html>
