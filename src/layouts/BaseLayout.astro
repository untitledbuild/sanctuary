---
import "@/styles/global.css";
import { site } from "@data/site";
import robotoFlexWoff2 from "@fontsource-variable/roboto-flex/files/roboto-flex-latin-wght-normal.woff2?url";
import instrumentSerifWoff2 from "@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name}: You need software. We build it.`,
  description = site.description,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Preload the two fonts that cover almost all above-the-fold text
         (headings = serif, everything else = sans) so first paint uses the
         real face instead of a fallback that then visibly swaps in. -->
    <link rel="preload" href={robotoFlexWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={instrumentSerifWoff2} as="font" type="font/woff2" crossorigin />

    <!--
      Google Consent Mode v2 — must run before the Usercentrics loader and
      before gtag.js/GTM are ever injected, so both start in a denied state.
      Neither is actually *loaded* until src/scripts/consent.ts sees an
      affirmative consent signal from Usercentrics (see below): this is the
      stricter "load nothing until consent" pattern, not the softer "load
      immediately but send cookieless pings" one, so there is no request to
      Google's endpoints — analytics or otherwise — before consent.
      ad_storage / ad_user_data / ad_personalization stay permanently denied:
      nothing in this codebase runs Google Ads or remarketing, so there is no
      basis to ever grant them.
    -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
      });
    </script>

    <!-- Usercentrics CMP -->
    <script
      is:inline
      id="usercentrics-cmp"
      src="https://app.usercentrics.eu/browser-ui/latest/loader.js"
      data-version="preview"
      data-settings-id="7ah7-7ZiK04Pax"
      async></script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#fffefd" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Supabase config for the contact form (PUBLIC anon key — safe to expose;
         see infra/supabase/schema.sql for the INSERT-only RLS that secures it). -->
    <meta
      name="supabase-url"
      content={import.meta.env.PUBLIC_SUPABASE_URL ?? ""}
    />
    <meta
      name="supabase-anon-key"
      content={import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? ""}
    />

    <!--
      Pre-paint bootstrap: hide reveal elements before first paint to avoid a
      flash, but only when JS is on AND motion is allowed. A failsafe un-hides
      everything if motion.ts never runs, so content can never get stuck.
    -->
    <script is:inline>
      (function () {
        try {
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;
          var root = document.documentElement;
          root.classList.add("js-motion");
          setTimeout(function () {
            if (!window.__motionReady) root.classList.remove("js-motion");
          }, 2500);
        } catch (e) {}
      })();
    </script>

    <!-- Brevo Conversations {literal} -->
    <script is:inline>
      (function (d, w, c) {
        w.BrevoConversationsID = "6a8a370f590231d6e20a6709";
        w[c] = w[c] || function () {
          (w[c].q = w[c].q || []).push(arguments);
        };
        var s = d.createElement("script");
        s.async = true;
        s.src = "https://conversations-widget.brevo.com/brevo-conversations.js";
        if (d.head) d.head.appendChild(s);
      })(document, window, "BrevoConversations");
    </script>
    <!-- /Brevo Conversations {/literal} -->
  </head>
  <body>
    <!-- No GTM <noscript> fallback: that iframe fires unconditionally for
         JS-disabled visitors, who never see the (JS-based) Usercentrics
         banner and so have had no opportunity to consent — keeping it would
         reopen the exact gap consent.ts closes for JS-enabled visitors. -->
    <!-- No global backdrop: each section owns its own grid/dot/hatch treatment
         to match the Figma (the engineering motif varies band to band). -->
    <slot />

    <script>
      import "../scripts/motion.ts";
      import "../scripts/form.ts";
      import "../scripts/consent.ts";
    </script>
  </body>
</html>
